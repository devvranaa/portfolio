---
import { site, navLinks } from '../data/site';
---

<header class="sticky top-0 z-40 border-b border-line bg-paper/90 backdrop-blur">
  <nav class="mx-auto flex h-[68px] max-w-7xl items-center justify-between gap-4 px-4 sm:px-6" aria-label="Primary">
    <a href="#top" class="font-display text-lg font-bold tracking-tight">
      {site.name}
    </a>
    <div class="flex items-center gap-1 sm:gap-2">
      <span class="hidden items-center gap-1 sm:flex sm:gap-2">
        {
          navLinks.map((link) => (
            <a
              href={link.href}
              class="rounded-full px-3 py-2 text-sm text-muted transition-colors hover:text-ink"
            >
              {link.label}
            </a>
          ))
        }
      </span>
      <a
        href="#contact"
        class="btn-primary ml-1 bg-accent px-4 py-2 text-sm font-semibold text-white transition-transform hover:scale-[1.02] active:scale-[0.98]"
      >
        Get in touch
      </a>
    </div>
  </nav>
</header>
