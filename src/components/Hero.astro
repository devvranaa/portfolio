---
---

<section id="top" class="mx-auto w-full max-w-7xl px-4 sm:px-6">
  <div class="grid grid-cols-1 items-start gap-10 pb-16 pt-24 md:grid-cols-2 lg:gap-14">
    <div>
      <p class="enter enter-1 font-mono text-[11px] uppercase tracking-[0.18em] text-accent">
        Student portfolio
      </p>
      <h1 class="enter enter-2 mt-4 text-4xl font-bold leading-[1.05] tracking-tighter md:text-5xl lg:text-6xl">
        Student developer making web games.
      </h1>
      <p class="enter enter-3 mt-5 max-w-[42ch] text-base leading-relaxed text-muted">
        I am a university student. So far I have built and deployed one game.
      </p>
      <div class="enter enter-4 mt-8 flex flex-wrap items-center gap-3">
        <a
          href="#work"
          class="btn-primary bg-ink px-6 py-3 text-sm font-semibold text-white transition-transform hover:scale-[1.02] active:scale-[0.98]"
        >
          View my work
        </a>
        <a
          href="#contact"
          class="btn-primary border border-line bg-white px-6 py-3 text-sm font-semibold text-ink transition-transform hover:scale-[1.02] active:scale-[0.98]"
        >
          Get in touch
        </a>
      </div>
    </div>
    <div class="enter enter-5">
      <!-- Stock photo until real game screenshots exist -->
      <img
        src="https://images.unsplash.com/photo-1522778119026-d647f0596c20?q=80&w=960&auto=format&fit=crop"
        alt="Packed football stadium during a night match"
        class="card aspect-[4/3] w-full border border-line object-cover"
        loading="eager"
        width="960"
        height="720"
      />
    </div>
  </div>
</section>
