---
import { getCollection, render } from 'astro:content';

const projects = (await getCollection('projects')).sort((a, b) => a.data.order - b.data.order);
const featured = await Promise.all(
  projects
    .filter((p) => p.data.featured)
    .map(async (project) => {
      const { Content } = await render(project);
      return { project, Content };
    })
);
---

<section id="work" class="mx-auto w-full max-w-7xl px-4 py-20 sm:px-6 md:py-28">
  <div>
    <p class="font-mono text-[11px] uppercase tracking-[0.18em] text-accent">Selected work</p>
    <h2 class="mt-3 max-w-[20ch] text-3xl font-bold tracking-tighter md:text-5xl">
      One finished project.
    </h2>
  </div>

  <div class="mt-12 grid gap-10">
    {
      featured.map(({ project, Content }) => (
          <article class="card grid grid-cols-1 overflow-hidden border border-line bg-white md:grid-cols-2">
            <div class="bg-stone-100">
              <!-- Stock photo until real game screenshots exist -->
              <img
                src={project.data.cover}
                alt={project.data.coverAlt}
                class="h-full min-h-[280px] w-full object-cover"
                loading="lazy"
                width="1200"
                height="900"
              />
            </div>
            <div class="flex flex-col justify-center p-8 md:p-10">
              <h3 class="text-2xl font-bold tracking-tight md:text-3xl">{project.data.title}</h3>
              <p class="mt-2 text-base leading-relaxed text-muted">{project.data.tagline}</p>
              <ul class="mt-5 flex flex-wrap gap-2" aria-label="Tech stack">
                {project.data.stack.map((tech) => (
                  <li class="rounded-full border border-line bg-paper px-3 py-1 font-mono text-xs text-muted">
                    {tech}
                  </li>
                ))}
              </ul>
              <div class="mt-5 md-body text-[15px] leading-relaxed text-muted">
                <Content />
              </div>
              <div class="mt-7 flex flex-wrap gap-3">
                {project.data.liveUrl && (
                  <a
                    href={project.data.liveUrl}
                    target="_blank"
                    rel="noreferrer"
                    class="btn-primary inline-flex items-center gap-2 bg-accent px-5 py-2.5 text-sm font-semibold text-white transition-transform hover:scale-[1.02] active:scale-[0.98]"
                  >
                    <i class="ph ph-arrow-square-out" aria-hidden="true" /> Play it live
                  </a>
                )}
                {project.data.repoUrl && (
                  <a
                    href={project.data.repoUrl}
                    target="_blank"
                    rel="noreferrer"
                    class="btn-primary inline-flex items-center gap-2 border border-line bg-white px-5 py-2.5 text-sm font-semibold text-ink transition-transform hover:scale-[1.02] active:scale-[0.98]"
                  >
                    <i class="ph ph-github-logo" aria-hidden="true" /> Read the code
                  </a>
                )}
              </div>
            </div>
          </article>
        ))
      }
  </div>
</section>
