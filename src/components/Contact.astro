---
import { site } from '../data/site';
---

<section id="contact" class="border-t border-line bg-white">
  <div class="mx-auto w-full max-w-7xl px-4 py-20 sm:px-6 md:py-28">
    <div class="grid grid-cols-1 items-center gap-10 md:grid-cols-2">
      <div>
        <h2 class="text-3xl font-bold tracking-tighter md:text-5xl">Like the game? Say hello.</h2>
        <p class="mt-4 max-w-[50ch] text-base leading-relaxed text-muted">
          Email works best. Feedback on the game is welcome.
        </p>
      </div>
      <div class="flex flex-col items-start gap-4 md:items-end">
        <a
          href={`mailto:${site.email}`}
          class="btn-primary inline-flex items-center gap-2 bg-accent px-7 py-3.5 text-base font-semibold text-white transition-transform hover:scale-[1.02] active:scale-[0.98]"
        >
          <i class="ph ph-envelope-simple" aria-hidden="true" /> Get in touch
        </a>
        <a
          href={site.github}
          target="_blank"
          rel="noreferrer"
          class="inline-flex items-center gap-2 text-sm font-semibold text-muted transition-colors hover:text-ink"
        >
          <i class="ph ph-github-logo text-lg" aria-hidden="true" /> GitHub profile
        </a>
      </div>
    </div>
  </div>
</section>
